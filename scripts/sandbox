#!/usr/bin/env bash
# A throwaway Herdr app on its own core, home and display, run by ruta, so
# Koja mods get tried without touching the real window.
#
#   scripts/sandbox up            install this checkout, start the display, the core and the window
#   scripts/sandbox restart       reinstall and restart the window
#   scripts/sandbox install       reinstall this checkout into a running sandbox
#   scripts/sandbox identity      run `ruta status`, then say whether the sandbox has this
#                                 checkout's current mods and config; exits 0 only when both
#                                 hold, and changes nothing
#   scripts/sandbox do <action> [json]   / status   drive it (herdr-app do / status)
#   scripts/sandbox hc <args>     hc against the sandbox core
#   scripts/sandbox shot [file]   screenshot of the window, in window pixels
#   scripts/sandbox move|click|drag|scroll|type|key|hold|release ...   fake input (window px)
#   scripts/sandbox log           the window's log
#   scripts/sandbox opened        links the window asked to open (logged, never opened)
#   scripts/sandbox down          stop everything and delete it
#
# Every command but install, identity, do, status, and hc goes to ruta; `ruta` without
# arguments lists them. RUTA_NAME=<name> runs a second sandbox side by side.
# HERDR_APP_BIN runs another herdr-app (an installed copy, to try updates)
# instead of the default.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
checkout=$(dirname "$here")
name=${RUTA_NAME-koja}

if [[ ! $name =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "RUTA_NAME must be one name of lowercase letters, digits, and dashes, not '$name'" >&2
  exit 2
fi

root=/var/tmp/ruta-$name

find_binary() {
  local chosen=${HERDR_APP_BIN:-}

  if [[ $chosen == */* ]]; then
    printf '%s\n' "$chosen"
    return 0
  fi

  if [[ -n $chosen ]]; then
    if ! command -v -- "$chosen"; then
      echo "HERDR_APP_BIN names no program on PATH: '$chosen'" >&2
      return 1
    fi
    return 0
  fi

  if command -v herdr-app >/dev/null 2>&1; then
    command -v herdr-app
    return 0
  fi

  printf '%s\n' "$HOME/.local/share/herdr-app/herdr-app"
}

require_up() {
  if [[ ! -x $root/bin/herdr-app ]]; then
    echo "sandbox $name is not up; run 'scripts/sandbox up' first" >&2
    exit 1
  fi
}

# Run a command with the folders ruta gives the app, so herdr-app and hc find
# the sandbox's home and core. The caller's own core and terminal variables,
# such as HC_SOCKET and HC_TERMINAL_SOCKET, must not reach it.
in_sandbox() {
  env -i \
    HOME="$root/home" \
    XDG_CONFIG_HOME="$root/config" \
    XDG_STATE_HOME="$root/state" \
    XDG_DATA_HOME="$root/data" \
    XDG_CACHE_HOME="$root/cache" \
    XDG_RUNTIME_DIR="$root/run" \
    PATH="$root/bin:$PATH" \
    RUTA_ROOT="$root" \
    TERM="${TERM:-dumb}" \
    LANG="${LANG:-C.UTF-8}" \
    "$@"
}

install_mods() {
  require_up
  (cd "$checkout" && in_sandbox HERDR_APP_HOME="$root/config/herdr-app" bun run herdr:install)
  in_sandbox "$checkout/scripts/sandbox-ready"
}

window_state() {
  if in_sandbox timeout 10 herdr-app status >/dev/null 2>&1; then
    echo answers
  else
    echo silent
  fi
}

case ${1:-} in
  up | restart)
    command=$1
    shift
    bin=$(find_binary)
    # The launch script runs from the checkout, so give it an absolute path.
    bin=$(realpath -ms -- "$bin")
    cd "$checkout"
    exec ruta "$command" "$@" -- "$bin"
    ;;
  install) install_mods ;;
  identity)
    cd "$checkout"
    ruta status || exit 1
    state=$(window_state)
    exec bun scripts/sandboxIdentity.ts "$name" "$root/config/herdr-app" "$checkout" "$state"
    ;;
  do | status) require_up; in_sandbox herdr-app "$@" ;;
  hc) require_up; shift; in_sandbox hc "$@" ;;
  shot)
    file=${2:+$(realpath -ms -- "$2")}
    cd "$checkout"
    exec ruta shot ${file:+"$file"}
    ;;
  *)
    cd "$checkout"
    exec ruta "$@"
    ;;
esac
