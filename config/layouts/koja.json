{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.11"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "koja-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "hidden": true
            }
          ]
        }
      ],
      "size": {
        "px": 268
      },
      "min": 200,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "koja-tabs"
          },
          "size": {
            "px": 28
          },
          "padding": [0, 6],
          "background": "chrome",
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "koja-pane"
                    },
                    "reveal": "always",
                    "height": 26,
                    "position": "top"
                  },
                  "background": "background",
                  "radius": 8,
                  "gap": 6,
                  "border": {
                    "width": 1,
                    "color": "selected"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "koja-changes"
                      }
                    }
                  ],
                  "active": "changes"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "radius": 8,
              "border": {
                "width": 1,
                "color": "selected"
              },
              "background": "background"
            }
          ],
          "gap": 6,
          "background": "chrome",
          "padding": 6
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "ui_font": "Geist",
  "terminal_padding": [4, 10],
  "terminal_opacity": 0,
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "terminal_menu": "koja-menu"
}
