{
  "global": {
    "ctrl-b": "mod.open:koja-modal"
  },
  "mod:koja-modal": {
    "ctrl-b": "koja-modal.hold",
    "tab": "koja-modal.section-next",
    "shift-tab": "koja-modal.section-previous"
  },
  "terminal": {
    "ctrl-backspace": "send:\u0017",
    "ctrl-left": "send:\u001bb",
    "ctrl-right": "send:\u001bf",
    "ctrl-shift-c": "terminal.copy",
    "ctrl-shift-v": "terminal.paste",
    "ctrl-v": "terminal.paste_image"
  },
  "mod:koja-picker": {
    "ctrl-shift-k": "koja-picker.next",
    "tab": "koja-picker.filter-next",
    "shift-tab": "koja-picker.filter-previous"
  }
}
