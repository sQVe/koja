{
  "testRunner": "bun",
  "bun": {
    "timeout": 600000,
    "bunArgs": ["--timeout", "60000"]
  },
  "coverageAnalysis": "perTest",
  "mutate": ["src/**/*.ts", "!src/**/*.test.ts"],
  "tsconfigFile": "stryker-no-tsconfig.json",
  "checkers": [],
  "plugins": ["@hughescr/stryker-bun-runner"],
  "concurrency": "50%",
  "timeoutMS": 10000,
  "timeoutFactor": 4,
  "fileLogLevel": "info",
  "ignorePatterns": [
    ".tau",
    "docs",
    "herdr",
    "tests/*.test.ts",
    "dist",
    "CHANGELOG.md",
    "src/mods/koja-picker/previewShell.test.ts"
  ],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
