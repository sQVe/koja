{
  "testRunner": "bun",
  "bun": {
    "timeout": 600000,
    "bunArgs": ["--timeout", "60000"]
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/mods/*/main.ts",
    "!src/kit/askFirst.ts",
    "!src/kit/button.ts",
    "!src/kit/dialog.ts",
    "!src/kit/dialogOpen.ts",
    "!src/kit/icon.ts",
    "!src/kit/index.ts",
    "!src/kit/layout.ts",
    "!src/kit/listRow.ts",
    "!src/kit/modName.ts",
    "!src/kit/overlay.ts",
    "!src/kit/overlayOpen.ts",
    "!src/kit/popupSurface.ts",
    "!src/kit/repoLabel.ts",
    "!src/kit/searchField.ts",
    "!src/kit/sectionHeader.ts",
    "!src/kit/shortcut.ts",
    "!src/kit/statusMark.ts",
    "!src/kit/tab.ts",
    "!src/kit/text.ts",
    "!src/kit/textField.ts",
    "!src/kit/theme.ts",
    "!src/kit/themes.ts",
    "!src/kit/window.ts",
    "!src/kit/worktree.ts",
    "!src/mods/koja-changes/preview.ts",
    "!src/mods/koja-changes/rows.ts",
    "!src/mods/koja-gallery/*.ts",
    "!src/mods/koja-mocks/scenes/**/*.ts",
    "!src/mods/koja-picker/launch.ts",
    "!src/mods/koja-picker/previewSession.ts",
    "!src/mods/koja-spaces/gitTracker.ts",
    "!src/mods/koja-spaces/machineRows.ts",
    "!src/mods/koja-spaces/rail.ts"
  ],
  "tsconfigFile": "stryker-no-tsconfig.json",
  "checkers": [],
  "plugins": ["@hughescr/stryker-bun-runner"],
  "concurrency": "50%",
  "timeoutMS": 10000,
  "timeoutFactor": 4,
  "fileLogLevel": "info",
  "ignorePatterns": [
    ".tau",
    "docs",
    "herdr",
    "tests/*.test.ts",
    "dist",
    "CHANGELOG.md",
    "src/mods/koja-picker/previewShell.test.ts"
  ],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
