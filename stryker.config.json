{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "bun",
  "bun": {
    "bunArgs": ["--config=bunfig.mutation.toml"],
    "env": { "KOJA_MUTATION": "1" },
    "timeout": 120000
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*Fixtures.ts",
    "!src/server/processInfo.ts",
    "!src/server/socketPath.ts",
    "!src/server/rowPublisher.ts",
    "!src/client/clipboardWrite.ts"
  ],
  "tsconfigFile": "stryker-no-tsconfig.json",
  "checkers": [],
  "plugins": ["@hughescr/stryker-bun-runner"],
  "concurrency": "50%",
  "timeoutMS": 2000,
  "timeoutFactor": 4,
  "incremental": true,
  "incrementalFile": ".tau/stryker-incremental.json",
  "fileLogLevel": "off",
  "ignorePatterns": [".tau", "docs", "CHANGELOG.md", "dist", "coverage", "build/ghostty"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
